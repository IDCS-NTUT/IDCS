[Unit]
Description=IDCS V2 fixed-rate controller metadata runtime
Wants=network-online.target
After=network-online.target idcs-deepstream-video.service

[Service]
Type=simple
User=idcs
WorkingDirectory=/home/idcs/Desktop/project/IDCS-v2-runtime
Environment=PYTHONPATH=/home/idcs/Desktop/project/IDCS-v2-runtime
ExecStartPre=/home/idcs/Desktop/project/bin/python tools/runtime_process_guard.py --module jetson.control_runtime
ExecStartPre=/home/idcs/Desktop/project/bin/python -m jetson.control_runtime --check
RuntimeDirectory=idcs
ExecStart=/home/idcs/Desktop/project/bin/python -m jetson.control_runtime --enable-live-intent-publish --ready-file /run/idcs/v2-controller.ready --health-file /run/idcs/v2-controller-health.json --report /home/idcs/Desktop/project/IDCS-v2-runtime/logs/v2-controller-report.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
