[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5
Description=IDCS gimbal bridge (ControlIntent -> F6, step-count CamState)
Requires=idcs-serial.service
After=idcs-serial.service
PartOf=idcs-hil.target

[Service]
Type=simple
User=idcs
WorkingDirectory=/home/idcs/Desktop/project/IDCS-runtime
Environment=PYTHONPATH=/home/idcs/Desktop/project/IDCS-runtime PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/bin/python tools/runtime_process_guard.py --module jetson.gimbal_bridge
# The bridge enables each active axis and refuses to run without F3 ACKs;
# on stop it sends zero speed and de-energizes.
ExecStartPre=/home/idcs/Desktop/project/bin/python -m jetson.gimbal_bridge --config configs/network.yaml --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_runtime.yaml,configs/gimbal_bench_uncoupled.yaml,configs/tuned_gimbal.yaml --enable-live-intent-actuation --check
ExecStart=/home/idcs/Desktop/project/bin/python -m jetson.gimbal_bridge --config configs/network.yaml --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_runtime.yaml,configs/gimbal_bench_uncoupled.yaml,configs/tuned_gimbal.yaml --enable-live-intent-actuation
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
