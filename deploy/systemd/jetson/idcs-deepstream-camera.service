[Unit]
Description=IDCS DeepStream on the Jetson's own IMX219 camera (sensor-stamped frames)
Conflicts=idcs-deepstream-video.service
PartOf=idcs-camera.target
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=idcs
WorkingDirectory=/home/idcs/Desktop/project/IDCS-runtime
Environment=PYTHONPATH=/home/idcs/Desktop/project/IDCS-runtime
# This checks configuration, endpoints, and the selected nvinfer profile.  It
# does not open a video, control, gimbal, serial, or GPU pipeline socket.
ExecStartPre=/home/idcs/Desktop/project/bin/python tools/runtime_process_guard.py --module jetson.deepstream.runtime
ExecStartPre=/home/idcs/Desktop/project/bin/python -m jetson.deepstream.runtime --config configs/base --config-extra configs/controller/local_camera.yaml --check
RuntimeDirectory=idcs
ExecStart=/home/idcs/Desktop/project/bin/python -m jetson.deepstream.runtime --config configs/base --config-extra configs/controller/local_camera.yaml --ready-file /run/idcs/deepstream-video.ready --health-file /run/idcs/deepstream-video-health.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

