[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5
Description=IDCS RS485 serial bus owner (sole writer of /dev/ttyCH341USB0)
Wants=network-online.target
After=network-online.target
PartOf=idcs-hil.target

[Service]
Type=simple
User=idcs
WorkingDirectory=/home/idcs/Desktop/project/IDCS-runtime
Environment=PYTHONPATH=/home/idcs/Desktop/project/IDCS-runtime PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/bin/python tools/runtime_process_guard.py --module tools.serial_io_service
ExecStartPre=/home/idcs/Desktop/project/bin/python -m tools.serial_io_service --config configs/network.yaml --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_runtime.yaml,configs/gimbal_bench_uncoupled.yaml --check
ExecStart=/home/idcs/Desktop/project/bin/python -m tools.serial_io_service --config configs/network.yaml --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_runtime.yaml,configs/gimbal_bench_uncoupled.yaml
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
