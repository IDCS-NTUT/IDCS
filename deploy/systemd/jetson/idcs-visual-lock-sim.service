[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5
Description=IDCS managed sim VPI visual lock (no detector or motor owner)
Conflicts=idcs-deepstream-camera.service idcs-deepstream-video.service idcs-visual-lock-camera.service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=idcs
WorkingDirectory=@RELEASE@
Environment=PYTHONPATH=@RELEASE@ PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/bin/python tools/runtime_process_guard.py --module jetson.visual_lock.live_trial --module jetson.deepstream.runtime
ExecStartPre=/home/idcs/Desktop/project/bin/python -m jetson.visual_lock.live_trial --managed-mode sim_visual_lock --config configs/base --source sim --library @RELEASE@/build/visual-lock/libidcs_visual_lock.so --surface-library @RELEASE@/build/visual-lock/libidcs_visual_lock_live_surface.so --output /var/lib/idcs/visual-lock/sim --health-file /run/idcs/visual-lock-sim-health.json --duration-s 0 --source-wait-s 60 --roi-bind tcp://0.0.0.0:5596 --return-identity-bind tcp://0.0.0.0:5595 --snapshot-bind tcp://0.0.0.0:5564 --provenance @RELEASE@ --check
RuntimeDirectory=idcs
StateDirectory=idcs/visual-lock/sim
ExecStart=/home/idcs/Desktop/project/bin/python -m jetson.visual_lock.live_trial --managed-mode sim_visual_lock --config configs/base --source sim --library @RELEASE@/build/visual-lock/libidcs_visual_lock.so --surface-library @RELEASE@/build/visual-lock/libidcs_visual_lock_live_surface.so --output /var/lib/idcs/visual-lock/sim --health-file /run/idcs/visual-lock-sim-health.json --duration-s 0 --source-wait-s 60 --roi-bind tcp://0.0.0.0:5596 --return-identity-bind tcp://0.0.0.0:5595 --snapshot-bind tcp://0.0.0.0:5564 --provenance @RELEASE@
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
