[Unit]
Description=IDCS read-only operator display for the Jetson camera
# One-way ordering only: sim-ui orders after this unit. Reciprocal After=
# creates a stop/stop cycle when the hardware UI conflicts with both.
After=graphical-session.target idcs-ui.service
Conflicts=idcs-ui.service idcs-sim-ui.service

[Service]
Type=simple
WorkingDirectory=/home/idcs/Desktop/project/IDCS-runtime
Environment=PYTHONPATH=/home/idcs/Desktop/project/IDCS-runtime PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 tools/runtime_process_guard.py --module pc.ui
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 -m pc.ui --config configs/base --config-extra configs/pc/operator_local.yaml --authority-label CAMERA --check
ExecStart=/home/idcs/Desktop/project/venv/bin/python3 -m pc.ui --config configs/base --config-extra configs/pc/operator_local.yaml --authority-label CAMERA
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
