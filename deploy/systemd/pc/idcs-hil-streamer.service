[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5
Description=IDCS simulator camera for live gimbal HIL (renders from measured pose)
After=graphical-session.target
Conflicts=idcs-sim.target

[Service]
Type=simple
WorkingDirectory=/home/idcs/Desktop/project/IDCS-runtime
Environment=PYTHONPATH=/home/idcs/Desktop/project/IDCS-runtime PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 tools/runtime_process_guard.py --module pc.streamer
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 -m pc.streamer --config configs/base --config-extra configs/sim/v2_scene.yaml,configs/sim/mode_hil.yaml --sim-perception-pub tcp://192.168.0.1:5574 --sim-total-latency-ms 100 --verified-rtp-headers --check
ExecStart=/home/idcs/Desktop/project/venv/bin/python3 -m pc.streamer --config configs/base --config-extra configs/sim/v2_scene.yaml,configs/sim/mode_hil.yaml --sim-perception-pub tcp://192.168.0.1:5574 --sim-total-latency-ms 100 --verified-rtp-headers
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
