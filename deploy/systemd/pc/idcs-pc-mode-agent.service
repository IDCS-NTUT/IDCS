[Unit]
Description=IDCS PC-initiated simulator mode agent (no inbound control endpoint)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/idcs/Desktop/project/IDCS-runtime
Environment=PYTHONPATH=/home/idcs/Desktop/project/IDCS-runtime PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 tools/runtime_process_guard.py --module pc.mode_agent
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 -m pc.mode_agent --config configs/base --check
ExecStart=/home/idcs/Desktop/project/venv/bin/python3 -m pc.mode_agent --config configs/base
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
