[Unit]
Description=IDCS simulated safety panel (armed auto state, loopback only)
PartOf=idcs-sim-session.target

[Service]
Type=simple
WorkingDirectory=@RELEASE@
Environment=PYTHONPATH=@RELEASE@ PYTHONUNBUFFERED=1
ExecStart=/home/idcs/Desktop/project/venv/bin/python3 -m tools.sim_panel --manual-state-endpoint tcp://127.0.0.1:15559 --physical-panel-endpoint tcp://192.168.0.3:5580
Restart=on-failure
RestartSec=2
