[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5
Description=IDCS simulator camera on a simulated mount (OpenGL scene, no hardware)
After=graphical-session.target
PartOf=idcs-sim.target
Conflicts=idcs-hil-streamer.service

[Service]
Type=simple
WorkingDirectory=/home/idcs/Desktop/project/IDCS-runtime
Environment=PYTHONPATH=/home/idcs/Desktop/project/IDCS-runtime PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 tools/runtime_process_guard.py --module pc.streamer
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 -m pc.streamer --config configs/network.yaml --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_runtime.yaml,configs/deepstream_pc_moving_tracking.yaml,configs/control_sim.yaml,configs/deepstream_pc_moving_tracking_opengl.yaml,configs/deepstream_pc_moving_drone_opengl.yaml,configs/sim_mode_simulated_mount.yaml --sim-control-sub tcp://127.0.0.1:5571 --sim-camstate-pub tcp://127.0.0.1:5572 --sim-perception-pub tcp://127.0.0.1:5574 --sim-total-latency-ms 100 --verified-rtp-headers --check
ExecStart=/home/idcs/Desktop/project/venv/bin/python3 -m pc.streamer --config configs/network.yaml --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_runtime.yaml,configs/deepstream_pc_moving_tracking.yaml,configs/control_sim.yaml,configs/deepstream_pc_moving_tracking_opengl.yaml,configs/deepstream_pc_moving_drone_opengl.yaml,configs/sim_mode_simulated_mount.yaml --sim-control-sub tcp://127.0.0.1:5571 --sim-camstate-pub tcp://127.0.0.1:5572 --sim-perception-pub tcp://127.0.0.1:5574 --sim-total-latency-ms 100 --verified-rtp-headers
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
