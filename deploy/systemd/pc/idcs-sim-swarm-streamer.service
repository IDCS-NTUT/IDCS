[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5
Description=IDCS simulator camera, swarm scene, on a simulated mount (no hardware)
After=graphical-session.target
PartOf=idcs-sim-swarm.target
Conflicts=idcs-hil-streamer.service idcs-sim-streamer.service

[Service]
Type=simple
WorkingDirectory=/home/idcs/Desktop/project/IDCS-runtime
Environment=PYTHONPATH=/home/idcs/Desktop/project/IDCS-runtime PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 tools/runtime_process_guard.py --module pc.streamer
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 -m pc.streamer --config configs/base --config-extra configs/sim/v2_scene.yaml,configs/sim/target_fast.yaml,configs/sim/mode_simulated_mount.yaml,configs/sim/swarm.yaml --sim-control-sub tcp://127.0.0.1:5571 --sim-camstate-pub tcp://127.0.0.1:5572 --sim-perception-pub tcp://127.0.0.1:5574 --sim-events-pub tcp://127.0.0.1:5576 --sim-total-latency-ms 100 --verified-rtp-headers --check
ExecStart=/home/idcs/Desktop/project/venv/bin/python3 -m pc.streamer --config configs/base --config-extra configs/sim/v2_scene.yaml,configs/sim/target_fast.yaml,configs/sim/mode_simulated_mount.yaml,configs/sim/swarm.yaml --sim-control-sub tcp://127.0.0.1:5571 --sim-camstate-pub tcp://127.0.0.1:5572 --sim-perception-pub tcp://127.0.0.1:5574 --sim-events-pub tcp://127.0.0.1:5576 --sim-total-latency-ms 100 --verified-rtp-headers
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
