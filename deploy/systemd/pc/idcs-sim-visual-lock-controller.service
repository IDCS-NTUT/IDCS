[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5
Description=IDCS video controller on Jetson visual-lock perception, simulated mount (PC, loopback only)
Requires=idcs-sim-visual-lock-streamer.service
After=idcs-sim-visual-lock-streamer.service idcs-sim-panel.service
PartOf=idcs-sim-visual-lock.target
Conflicts=idcs-sim-controller.service idcs-sim-swarm-controller.service

[Service]
Type=simple
WorkingDirectory=@RELEASE@
Environment=PYTHONPATH=@RELEASE@ PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 tools/runtime_process_guard.py --module jetson.control.video_runtime
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 -m jetson.control.video_runtime --config configs/base --config-extra configs/sim/v2_scene.yaml,configs/controller/sim_mount.yaml,configs/bench/tuned.yaml,configs/controller/detections.yaml --check
RuntimeDirectory=idcs-sim
ExecStart=/home/idcs/Desktop/project/venv/bin/python3 -m jetson.control.video_runtime --config configs/base --config-extra configs/sim/v2_scene.yaml,configs/controller/sim_mount.yaml,configs/bench/tuned.yaml,configs/controller/detections.yaml --ready-file %t/idcs-sim/controller.ready --health-file %t/idcs-sim/controller-health.json --report %t/idcs-sim/controller-report.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
