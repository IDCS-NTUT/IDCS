[Unit]
Description=IDCS V2 loopback estimator-study controller (%i plant)
After=idcs-v2-estimator-sim-streamer@%i.service
Requires=idcs-v2-estimator-sim-streamer@%i.service
Conflicts=idcs-v2-sim-controller.service

[Service]
Type=simple
WorkingDirectory=/home/idcs/Desktop/project/IDCS
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/.venv/bin/python tools/runtime_process_guard.py --module jetson.sim_control_runtime
ExecStartPre=/home/idcs/Desktop/project/.venv/bin/python -m jetson.sim_control_runtime --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_pc_moving_tracking.yaml,configs/deepstream_estimator_drone_fixture.yaml,configs/control_sim.yaml,configs/control_sim_estimator_%i.yaml --snapshot-sub tcp://127.0.0.1:5574 --sim-diagnostics-bind tcp://127.0.0.1:5573 --check
ExecStart=/home/idcs/Desktop/project/.venv/bin/python -u -m jetson.sim_control_runtime --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_pc_moving_tracking.yaml,configs/deepstream_estimator_drone_fixture.yaml,configs/control_sim.yaml,configs/control_sim_estimator_%i.yaml --snapshot-sub tcp://127.0.0.1:5574 --sim-diagnostics-bind tcp://127.0.0.1:5573 --trace /home/idcs/Desktop/project/IDCS/logs/estimator-sim-%i-trace.jsonl --report /home/idcs/Desktop/project/IDCS/logs/estimator-sim-%i-report.json --enable-sim-control
Restart=no
TimeoutStopSec=10

[Install]
WantedBy=default.target
