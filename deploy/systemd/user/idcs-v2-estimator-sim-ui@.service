[Unit]
Description=IDCS V2 estimator-study return-video UI (%i plant)
After=graphical-session.target idcs-v2-estimator-sim-controller@%i.service
Requires=idcs-v2-estimator-sim-controller@%i.service
Conflicts=idcs-v2-sim-ui.service

[Service]
Type=simple
WorkingDirectory=/home/idcs/Desktop/project/IDCS
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/.venv/bin/python tools/runtime_process_guard.py --module pc.ui
ExecStart=/home/idcs/Desktop/project/.venv/bin/python -u -m pc.ui --config configs/network.yaml --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_pc_moving_tracking.yaml,configs/deepstream_estimator_drone_fixture.yaml,configs/control_sim.yaml,configs/control_sim_estimator_%i.yaml --control-sub tcp://127.0.0.1:5571 --camstate-sub tcp://127.0.0.1:5572 --diagnostics-sub tcp://127.0.0.1:5573 --authority-label SIM-%i --report /home/idcs/Desktop/project/IDCS/logs/estimator-sim-%i-ui-report.json
Restart=no
TimeoutStopSec=10

[Install]
WantedBy=default.target
