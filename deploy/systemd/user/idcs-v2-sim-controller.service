[Unit]
Description=IDCS V2 loopback-only simulation baseline controller
After=idcs-v2-sim-streamer.service
Requires=idcs-v2-sim-streamer.service

[Service]
Type=simple
WorkingDirectory=/home/idcs/Desktop/project/IDCS
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/.venv/bin/python tools/runtime_process_guard.py --module jetson.sim_control_runtime
ExecStartPre=/home/idcs/Desktop/project/.venv/bin/python -m jetson.sim_control_runtime --check
ExecStart=/home/idcs/Desktop/project/.venv/bin/python -u -m jetson.sim_control_runtime --report /home/idcs/Desktop/project/idcs-v2-sim-controller-live-report.json --enable-sim-control
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=default.target
