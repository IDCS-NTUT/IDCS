[Unit]
Description=IDCS V2 OpenGL simulation video streamer
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/idcs/Desktop/project/IDCS
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/.venv/bin/python tools/runtime_process_guard.py --module pc.streamer
ExecStart=/home/idcs/Desktop/project/.venv/bin/python -u -m pc.streamer --config configs/network.yaml --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_pc_moving_tracking.yaml,configs/control_sim.yaml,configs/deepstream_pc_moving_tracking_opengl.yaml,configs/deepstream_pc_moving_drone_opengl.yaml --sim-control-sub tcp://127.0.0.1:5571 --sim-camstate-pub tcp://127.0.0.1:5572
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=default.target
