[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5
Description=IDCS V3 simulator camera for live gimbal HIL (renders from measured pose)
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/idcs/Desktop/project/IDCS-v3-runtime
Environment=PYTHONPATH=/home/idcs/Desktop/project/IDCS-v3-runtime PYTHONUNBUFFERED=1
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 tools/runtime_process_guard.py --module pc.streamer
ExecStartPre=/home/idcs/Desktop/project/venv/bin/python3 -m pc.streamer --config configs/network.yaml --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_runtime.yaml,configs/sim_hil_target_ellipse.yaml --sim-perception-pub tcp://192.168.0.1:5574 --sim-total-latency-ms 100 --check
ExecStart=/home/idcs/Desktop/project/venv/bin/python3 -m pc.streamer --config configs/network.yaml --config-extra configs/perception.yaml,configs/control.yaml,configs/system.yaml,configs/deepstream_runtime.yaml,configs/sim_hil_target_ellipse.yaml --sim-perception-pub tcp://192.168.0.1:5574 --sim-total-latency-ms 100
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
