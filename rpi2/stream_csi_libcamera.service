[Unit]
Description=Stream CSI camera to Jetson via libcamera+GStreamer
After=network.target

[Service]
Type=simple
User=idcs
ExecStart=/usr/bin/env bash /home/Desktop/project/rpi2/stream_csi_libcamera.sh 192.168.0.5 5000 1280 720 30 4000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
